%% Datos

% Eléctricos
Vn = 350; %V
Imax = 103; %A
J = 12; %A/mm2
p = 5; %polos
fn = 1000; %Hz


% Físicos
Nn = 12000; %rpm
Sigma_tan = 24500; %Pa


% Magnéticos
Uo = 4*pi*10^(-7); %H/m
B_delta = 0.8; %Tesla
B_sat = 1.9; %Tesla
B_cd = 1.46; %Tesla

% Dimensiones
Dext = 65; %mm
Lu = 90; %mm
delta = 0.9; %mm
Ns = 12; %ranuras/dientes
w_sz = 5; %mm (separación entre zapatas)
t_lam = 0.3; %mm
alpha_chaflan = 30; %deg


% Constantes
ksat = 1.225;
Kst = 0.95;
kfill = 0.45;





%% Ecuaciones

syms Dei;

%Paso linear de ranura y diente

tau_d = (pi*Dei)/Ns;

%Flujo magnético máximo del diente

Phi_d_max = B_delta * tau_d * Lu * ksat;

%Ancho del cuerpo del diente

w_cd = Phi_d_max/(Kst * Lu * B_cd);

S_cd = Phi_d_max/B_cd;

Relacion_cd_tau_d = w_cd/tau_d;

%Carga lineal

A_carga = Sigma_tan/B_delta;

%Area útil

A_u = (A_carga*tau_d)/(kfill*J);

%Altura del diente

hd = (A_carga*tau_d)/(kfill*J*(tau_d-w_cd));

%Pofundidad de zapata

hz1 = 2 * t_lam;
hz2 = (Uo*A_carga*tau_d)/(2*(B_cd-B_delta)) * (w_sz/delta);

hz = max(hz1,hz2);

% Altura zapata

Deltax = ((tau_d-w_sz)-w_cd)/2;

dchaflan = Deltax*tand(alpha_chaflan);

%Altura Yugo

Phi_p = 1.2* Phi_d_max;

h_y = Phi_p/(2*Kst*Lu*B_cd);

%Diámetro interioe
